# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq API calls (OpenAI GPT-OSS, Llama, etc.).
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Required for OpenRouter API calls (Llama 3.3 70B free, Qwen, DeepSeek).
OPENROUTER_API_KEY=""

# BRAVE_SEARCH_API_KEY: Required for web search and news search via Brave Search API.
BRAVE_SEARCH_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: Secret required for memory writes and Pydroid/project exports.
# Generate a long random value and add the same value to the Render environment.
ADMIN_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
